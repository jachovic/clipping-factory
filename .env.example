# Copy to .env, then: chmod 600 .env   (never commit .env)
# ---- required for 24/7 deployment
POSTGRES_PASSWORD=change-me-long-random
DASHBOARD_TOKEN=change-me-long-random          # open /login?token=... once; cookie afterwards

# ---- Telegram control center (create bot with @BotFather; get your numeric ID from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# ---- Crayo (Crayo app -> Developers page -> create key; starts with crayo_sk_)
CRAYO_API_KEY=
CRAYO_TEST_CLIP_CAP=2                          # clips allowed before you approve scaling up
CRAYO_USD_PER_EXPORT_CREDIT=0                  # your plan price / export credits, for cost tracking

# ---- Spending limits for variable costs (USD)
DAILY_SPEND_LIMIT_USD=5
MONTHLY_SPEND_LIMIT_USD=60

# ---- Whop bounties (user OAuth token; see INTEGRATIONS.md)
WHOP_USER_TOKEN=

# ---- YouTube publishing (Google OAuth client + per-channel refresh token)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN_YOUTUBE_1=
YOUTUBE_REFRESH_TOKEN_YOUTUBE_2=

# ---- Local engine
WHISPER_MODEL=base                             # tiny|base|small|medium (bigger = better, slower)

# ---- Optional: AI ranking of clip moments with Claude (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=
